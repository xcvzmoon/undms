{
  "name": "undms",
  "description": "Asynchronous document text and metadata extraction with bounded single and batch processing",
  "version": "1.6.0",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xcvzmoon/undms.git"
  },
  "author": {
    "name": "Mon Albert Gamil",
    "email": "mrgamilmonalbert@gmail.com",
    "url": "https://github.com/xcvzmoon/"
  },
  "keywords": [
    "document",
    "pdf",
    "word",
    "docs",
    "excel",
    "text-extraction",
    "metadata-extraction"
  ],
  "files": [
    "index.d.ts",
    "index.js",
    "index.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "node scripts/napi.ts artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "bench:text": "node --import @oxc-node/core/register benchmark/bench-text.ts",
    "bench:documents": "node --import @oxc-node/core/register benchmark/bench-documents.ts",
    "bench:image": "node --import @oxc-node/core/register benchmark/bench-image.ts",
    "bench:optimization": "node --import @oxc-node/core/register benchmark/bench-optimization.ts",
    "build": "node scripts/napi.ts build-all",
    "build:cjs": "node scripts/napi.ts build --platform --release --js index.js",
    "build:esm": "node scripts/napi.ts build --platform --release --esm --js index.mjs",
    "build:debug": "node scripts/napi.ts build --platform",
    "fmt": "run-p --npm-path pnpm fmt:oxfmt fmt:rs fmt:toml",
    "fmt:oxfmt": "vp fmt && vp fmt --check",
    "fmt:toml": "taplo format",
    "fmt:rs": "cargo fmt",
    "lint": "vp lint --type-aware",
    "prepublishOnly": "echo 'Publishing split packages via CI workflow'",
    "test": "pnpm run build && ava",
    "test:bindings": "ava",
    "preversion": "pnpm run build:cjs && pnpm run build:esm && git add .",
    "version": "node scripts/napi.ts version",
    "prepare": "husky",
    "changelog": "changelogen",
    "changelog:bump": "changelogen --bump",
    "changelog:release": "changelogen --release",
    "bench:report": "node --import @oxc-node/core/register benchmark/bench-report.ts",
    "bench:ocr": "pnpm run bench:packages --only image",
    "bench:packages": "pnpm run build && node --import @oxc-node/core/register benchmark/bench-packages.ts",
    "bench:compare": "pnpm run build && node --import @oxc-node/core/register benchmark/bench-compare.ts",
    "create-npm-dirs": "node scripts/napi.ts create-npm-dirs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p __test__/tsconfig.json",
    "check": "vp check",
    "release": "genbumppush --yes"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1",
    "@oxc-node/core": "^0.0.35",
    "@taplo/cli": "^0.7.0",
    "@types/node": "^25.3.0",
    "ava": "^6.4.1",
    "chalk": "^5.6.2",
    "changelogen": "^0.6.2",
    "consola": "^3.4.2",
    "genbumppush": "^0.0.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "npm-run-all2": "^8.0.4",
    "oxc-minify": "^0.152.0",
    "tinybench": "^6.0.0",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:"
  },
  "optionalDependencies": {
    "@undms/darwin-arm64": "1.5.1",
    "@undms/darwin-x64": "1.5.1",
    "@undms/linux-arm64-gnu": "1.5.1",
    "@undms/linux-x64-gnu": "1.5.1",
    "@undms/linux-x64-musl": "1.5.1",
    "@undms/win32-x64-msvc": "1.5.1"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "vp lint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{js,ts,json,jsonc,md,yml,yaml}": [
      "vp fmt --no-error-on-unmatched-pattern"
    ],
    "*.toml": [
      "taplo format"
    ]
  },
  "ava": {
    "extensions": {
      "ts": "module"
    },
    "timeout": "2m",
    "workerThreads": false,
    "environmentVariables": {
      "OXC_TSCONFIG_PATH": "./__test__/tsconfig.json"
    },
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0"
}
